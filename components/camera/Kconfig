menu "Camera Configuration"

    config CAMERA_PIN_PWDN
        int "PWDN GPIO（未接则填 -1）"
        range -1 48
        default -1

    config CAMERA_PIN_RESET
        int "RESET GPIO（未接则填 -1）"
        range -1 48
        default -1

    config CAMERA_PIN_XCLK
        int "XCLK GPIO"
        range -1 48
        default -1
        help
            尚未验证，需根据实际硬件（ICGOICIC ESP32-S3-WROOM N16R8 CAM，OV3660 传感器）
            确认后填写。不同批次/卖家的板子引脚分配可能不同，建议用万用表对 FPC
            排线和主板过孔做导通测试确认，再填入本项，否则 camera_init() 会直接报错退出。

    config CAMERA_PIN_SIOD
        int "SIOD(SDA) GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_SIOC
        int "SIOC(SCL) GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D0
        int "D0 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D1
        int "D1 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D2
        int "D2 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D3
        int "D3 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D4
        int "D4 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D5
        int "D5 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D6
        int "D6 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_D7
        int "D7 GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_VSYNC
        int "VSYNC GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_HREF
        int "HREF GPIO"
        range -1 48
        default -1

    config CAMERA_PIN_PCLK
        int "PCLK GPIO"
        range -1 48
        default -1

    config CAMERA_XCLK_FREQ_HZ
        int "XCLK 频率（Hz）"
        default 20000000
        help
            OV3660 常用 20MHz；如遇初始化失败或花屏，可尝试降到 10000000（10MHz）。

endmenu
