/*
 * MQTT Broker 登录凭据模板
 * 用法：复制这个文件为 mqtt_secrets.h（同目录下），填入真实的用户名/密码。
 * mqtt_secrets.h 已加入 .gitignore，不会被提交到 git。
 *
 * 凭据在 HiveMQ Cloud 控制台的 Access Management 页面创建。
 * 若 Broker 不需要鉴权，两个宏都留空字符串即可。
 */
#ifndef MQTT_SECRETS_H
#define MQTT_SECRETS_H

#define MQTT_SECRET_USERNAME ""
#define MQTT_SECRET_PASSWORD ""

#endif /* MQTT_SECRETS_H */
